diff --git a/app/globals.css b/app/globals.css
index 8d2f272..7288765 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -501,3 +501,41 @@
 
   /* ---- Guide pages: the in-page "In this guide" list is also a <nav>; it must scroll with the page, not stick over the header ---- */
   nav[aria-label="In this guide"]{position:static; z-index:auto; background:none; backdrop-filter:none; border-bottom:0}
+
+  /* ---- Homepage card "Follow one entry through the books": fit on one screen on laptops and zoomed screens ---- */
+  @media (min-width:861px) and (max-height:860px){
+    .hx-hero{padding:36px 0 48px}
+    .hx-hero .hx-split{align-items:flex-start}
+    .hx-hero .hx-copy{flex:1.15 1 480px}
+    .hx-trace{padding:20px 24px 18px; gap:14px}
+    .hx-trace-h{flex-wrap:nowrap}
+    .hx-trace-h .t{font-size:16.5px; white-space:nowrap}
+    .hx-book{height:clamp(440px, calc(100svh - 240px), 480px)}
+    .hx-steps button{padding:6px 14px; min-height:0}
+    .hx-page{gap:10px}
+    .hx-swipe{display:none}
+  }
+  @media (min-width:861px) and (max-height:700px){
+    .hx-hero{padding:22px 0 36px}
+    .hx-split{gap:40px}
+    .hx-trace{padding:14px 20px 14px; gap:10px}
+    .hx-trace-h{flex-wrap:nowrap}
+    .hx-trace-h .t{font-size:15.5px; white-space:nowrap}
+    .hx-tabs button{min-height:32px; padding:0 12px; font-size:13.5px}
+    .hx-book{height:clamp(318px, calc(100svh - 205px), 440px)}
+    .hx-page{padding:14px 20px 8px 36px; gap:7px}
+    .hx-pv{padding-bottom:6px}
+    .hx-pv .big{font-size:28px}
+    .hx-pv .ln,.hx-ds,.hx-rows div,.hx-dn,.hx-hint{font-size:13.5px; line-height:1.35}
+    .hx-steps{gap:0}
+    .hx-steps button{padding:4px 12px}
+    .hx-steps button b{font-size:14px}
+    .hx-steps button span{font-size:13.5px; line-height:1.3}
+    .hx-steps button:before{top:11px}
+    .hx-hint{display:none}
+    .hx-dt{font-size:20px}
+    .hx-rows div{padding:6px 0}
+    .hx-dn{padding:8px 12px}
+    .hx-back{min-height:32px; font-size:14px}
+    .hx-foot{font-size:13px}
+  }
