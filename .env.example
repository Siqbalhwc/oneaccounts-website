# Public site address
NEXT_PUBLIC_SITE_URL=https://www.oneaccountsbysiqbal.com

# Supabase (create a NEW project for the website, separate from the ERP)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
